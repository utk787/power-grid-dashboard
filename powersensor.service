[Unit]
Description=Power status dashboard
After=network-online.target
Wants=network-online.target

[Service]
User=utkarsh
WorkingDirectory=/home/utkarsh/powersensor
# All settings live in config.ini; restart the service after editing it.
ExecStart=/usr/bin/python3 /home/utkarsh/powersensor/app.py --config /home/utkarsh/powersensor/config.ini
Restart=always
RestartSec=3
# Exit code 2 = invalid config: stop instead of restarting in a loop (fix config.ini, then start).
RestartPreventExitStatus=2
# Keep the footprint small on the Pi
MemoryMax=80M
Nice=5

[Install]
WantedBy=multi-user.target
