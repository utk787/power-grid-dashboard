[Unit]
# Keeps a reverse SSH tunnel open from the Pi to the Oracle Cloud VM, so the dashboard
# (port 8080 here) appears on the VM as 127.0.0.1:18080, where Caddy serves it publicly.
# The Pi connects outward, so this works behind CGNAT without any router changes.
# Replace VM_HOST below with the VM's public IP or domain (see ADMINISTRATION.md §4, Option C).
Description=Reverse SSH tunnel for the power dashboard
After=network-online.target powersensor.service
Wants=network-online.target

[Service]
User=utkarsh
# -N: no remote command, only the tunnel. ExitOnForwardFailure: exit (and be restarted) if the
# VM still holds the port from a dead session. ServerAlive*: notice a dead link within ~90 s.
ExecStart=/usr/bin/ssh -N -T \
    -i /home/utkarsh/.ssh/powersensor_tunnel \
    -o ExitOnForwardFailure=yes \
    -o ServerAliveInterval=30 -o ServerAliveCountMax=3 \
    -o StrictHostKeyChecking=accept-new \
    -o BatchMode=yes \
    -R 127.0.0.1:18080:127.0.0.1:8080 \
    tunnel@VM_HOST
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
