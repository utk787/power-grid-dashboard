# Caddy config for the Oracle Cloud VM: the public front door for the dashboard, and HTTPS
# for the Headscale control server.
#
# The app runs on the Raspberry Pi at home (it has to: the sensor is on the home LAN). The Pi
# and this VM are on a private WireGuard network coordinated by Headscale, and Caddy reaches
# the Pi at its private address. Caddy gets and renews both HTTPS certificates itself.
#
# setup-vm.sh installs this as /etc/caddy/Caddyfile with {{SITE_DOMAIN}}, {{HS_DOMAIN}} and
# {{PI_UPSTREAM}} (the Pi's private address:8080) filled in.
# After editing by hand:  sudo caddy validate --config /etc/caddy/Caddyfile && sudo systemctl reload caddy

# The dashboard, for everyone.
{{SITE_DOMAIN}} {
	reverse_proxy {{PI_UPSTREAM}} {
		# The Pi is behind a home connection: fail fast instead of hanging when it's unreachable.
		transport http {
			dial_timeout 5s
			response_header_timeout 20s
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	# Pi unreachable (Pi off, home internet or power out): explain instead of a bare 502.
	handle_errors {
		@unreachable expression `{err.status_code} in [502, 503, 504]`
		handle @unreachable {
			@api path /api/* /healthz
			handle @api {
				header Content-Type application/json
				header Cache-Control no-store
				respond `{"error": "the power monitor at home can't be reached right now (its internet or power may be down)"}` 503
			}
			handle {
				root * /var/www/powersensor
				rewrite * /offline.html
				header Cache-Control no-store
				file_server
			}
		}
	}

	# No access log on purpose: like the app, this doesn't record who visits.
}

# Headscale, the control server for the private network (used by the Pi and this VM).
{{HS_DOMAIN}} {
	reverse_proxy 127.0.0.1:8081
	header -Server
}
